# Indholdskilde: "local" (markdown i src/content) eller "sanity"
CMS_SOURCE=local

# --- Kun nødvendigt når CMS_SOURCE=sanity ---------------------------
# Findes i Sanity-projektets indstillinger (sanity.io/manage)
SANITY_PROJECT_ID=
SANITY_DATASET=production
SANITY_API_VERSION=2024-10-01

# Læse-token. Kun nødvendigt hvis datasættet er privat.
# Må ALDRIG committes — læg den i .env eller som secret i CI.
SANITY_READ_TOKEN=

# Sæt til "false" for altid at hente friske data (langsommere build)
SANITY_USE_CDN=true
