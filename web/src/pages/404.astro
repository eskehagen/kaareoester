---
import Base from '~/layouts/Base.astro';
import { cms } from '~/lib/cms';

const forslag = await cms.getEntries({ limit: 3 });
---

<Base title="Siden findes ikke" noindex>
  <section class="shell flex min-h-[70vh] flex-col justify-center py-24 pt-[calc(var(--header-height)+4rem)]">
    <p class="eyebrow">Fejl 404</p>
    <h1 class="mt-4 max-w-2xl text-hero">Her er ingen vej</h1>
    <p class="mt-6 max-w-lg text-[1.05rem] leading-relaxed text-ink-500">
      Siden er enten flyttet, eller også har den aldrig eksisteret. Prøv en af vejene herunder.
    </p>

    <div class="mt-10 flex flex-wrap gap-3">
      <a
        href="/"
        class="rounded-full bg-ink-900 px-7 py-3.5 text-[0.92rem] text-paper transition-colors hover:bg-clay-600"
      >
        Til forsiden
      </a>
      <a
        href="/galleri"
        class="rounded-full border border-sand-300 px-7 py-3.5 text-[0.92rem] text-ink-700 transition-colors hover:border-ink-900"
      >
        Billedarkivet
      </a>
    </div>

    {
      forslag.length > 0 && (
        <div class="mt-16">
          <p class="eyebrow">Seneste indlæg</p>
          <ul class="mt-5 divide-y divide-sand-200 border-y border-sand-200">
            {forslag.map((entry) => (
              <li>
                <a
                  href={entry.href}
                  class="group flex items-baseline justify-between gap-6 py-4 transition-colors hover:text-clay-600"
                >
                  <span class="font-[--font-display] text-[1.1rem] text-ink-900 group-hover:text-clay-600">
                    {entry.title}
                  </span>
                  <span class="shrink-0 text-[0.82rem] text-ink-400">
                    {entry.date.getFullYear()}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      )
    }
  </section>
</Base>
