---
import Base from '~/layouts/Base.astro';
import { cms } from '~/lib/cms';

const settings = await cms.getSettings();

const emner = [
  {
    title: 'Bøger og læremidler',
    text: 'Forfatteropgaver, redaktion og fagligt review på materialer til grundskolen og ungdomsuddannelserne.',
  },
  {
    title: 'Foredrag og kurser',
    text: 'Oplæg om geografi, klima, bæredygtighed og faglig læsning — for lærere, studerende og foreninger.',
  },
  {
    title: 'Billeder',
    text: 'Forespørgsler om brug af rejsebilleder i undervisning, publikationer eller udstillinger.',
  },
];
---

<Base title="Kontakt" description={`Kontakt ${settings.title} — ${settings.email}`}>
  <section class="relative overflow-hidden pt-[var(--header-height)]">
    <div
      class="pointer-events-none absolute -left-32 top-10 h-[28rem] w-[28rem] rounded-[var(--radius-blob)] bg-moss-400/12 blur-3xl"
      aria-hidden="true"
    >
    </div>

    <div class="shell py-20 md:py-28">
      <p class="eyebrow" data-reveal>Kontakt</p>
      <h1 class="mt-4 max-w-3xl text-hero" data-reveal style="--reveal-delay:60ms">
        Lad os tage en snak
      </h1>
      <p
        class="mt-7 max-w-xl text-[1.06rem] leading-[1.75] text-ink-500"
        data-reveal
        style="--reveal-delay:130ms"
      >
        Skriv endelig, hvis du har en idé, et projekt eller bare et spørgsmål. Jeg svarer så hurtigt,
        jeg kan — også hvis jeg er på farten.
      </p>

      <a
        href={`mailto:${settings.email}`}
        class="group mt-12 inline-flex items-center gap-4 font-display text-[clamp(1.5rem,4.5vw,3rem)] tracking-tight text-ink-900 transition-colors duration-400 hover:text-clay-600"
        data-reveal
        style="--reveal-delay:200ms"
      >
        <span class="link-underline">{settings.email}</span>
        <span
          class="grid h-11 w-11 shrink-0 place-items-center rounded-full border border-sand-300 transition-all duration-400 group-hover:translate-x-1 group-hover:border-clay-500 group-hover:bg-clay-500 group-hover:text-white md:h-14 md:w-14"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 12h13M13 6l6 6-6 6" />
          </svg>
        </span>
      </a>
    </div>
  </section>

  <section class="border-t border-sand-200 bg-sand-50 py-20">
    <div class="shell grid gap-10 md:grid-cols-3">
      {
        emner.map((emne, index) => (
          <div data-reveal style={`--reveal-delay:${index * 90}ms`}>
            <h2 class="font-display text-xl text-ink-900">{emne.title}</h2>
            <p class="mt-3 text-[0.96rem] leading-relaxed text-ink-500">{emne.text}</p>
          </div>
        ))
      }
    </div>
  </section>
</Base>
