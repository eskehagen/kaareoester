---
import SmartImage from '~/components/SmartImage.astro';
import { formatYear } from '~/lib/format';
import { KIND_LABEL } from '~/lib/cms/types';
import type { Entry } from '~/lib/cms/types';

interface Props {
  entry: Entry;
  /** 'default' til gitre, 'wide' til fremhævede rækker, 'compact' til lister. */
  variant?: 'default' | 'wide' | 'compact';
  loading?: 'lazy' | 'eager';
  class?: string;
  /** Øvrige attributter (fx data-reveal) sættes på kortets rod. */
  [key: string]: unknown;
}

const {
  entry,
  variant = 'default',
  loading = 'lazy',
  class: className = '',
  ...rest
} = Astro.props;

const ratio = variant === 'wide' ? '16/10' : '4/3';
const kindLabel = KIND_LABEL[entry.kind].singular;
const photoCount = entry.gallery.length;

/** Uden billede får kortet en typografisk forside i stedet for et tomt felt. */
const initial = entry.title.trim().charAt(0).toUpperCase();
---

<article class={`group ${className}`} {...rest}>
  <a href={entry.href} class="block focus-visible:outline-none">
    <div
      class="relative overflow-hidden rounded-2xl bg-sand-100 shadow-soft transition-shadow duration-500 group-hover:shadow-lift md:rounded-[1.5rem]"
      style={`aspect-ratio:${ratio}`}
    >
      {
        entry.cover ? (
          <SmartImage
            image={entry.cover}
            widths={[400, 700, 1000, 1400]}
            sizes={
              variant === 'wide'
                ? '(max-width: 768px) 100vw, 66vw'
                : '(max-width: 768px) 100vw, 33vw'
            }
            loading={loading}
            class="img-zoom h-full w-full object-cover"
          />
        ) : (
          <div class="relative grid h-full w-full place-items-center overflow-hidden bg-gradient-to-br from-sand-100 via-sand-200 to-sand-300">
            <span
              class="absolute -right-6 -top-10 h-40 w-40 rounded-[var(--radius-blob)] bg-clay-400/15 transition-transform duration-700 group-hover:scale-110"
              aria-hidden="true"
            />
            <span
              class="font-[--font-display] text-[5.5rem] leading-none text-ink-900/12 transition-transform duration-700 group-hover:scale-105"
              aria-hidden="true"
            >
              {initial}
            </span>
          </div>
        )
      }

      <span
        class="pointer-events-none absolute inset-0 bg-gradient-to-t from-ink-900/45 via-transparent to-transparent opacity-0 transition-opacity duration-500 group-hover:opacity-100"
      ></span>

      {
        photoCount > 1 && (
          <span class="pointer-events-none absolute bottom-3 right-3 flex items-center gap-1.5 rounded-full bg-white/88 px-2.5 py-1 text-[0.7rem] font-medium text-ink-700 backdrop-blur-sm">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
              <rect x="3" y="5" width="18" height="14" rx="2.5" />
              <path d="m3 16 5-4 4 3 3-2.5 6 4.5" />
            </svg>
            {photoCount}
          </span>
        )
      }
    </div>

    <div class="mt-4">
      <p class="flex items-center gap-2 text-[0.72rem] uppercase tracking-[0.14em] text-ink-400">
        <span class="text-clay-600">{kindLabel}</span>
        <span class="h-px w-4 bg-sand-300"></span>
        <span>{formatYear(entry.date)}</span>
      </p>

      <h3
        class:list={[
          'mt-2 font-[--font-display] tracking-tight text-ink-900 transition-colors duration-300 group-hover:text-clay-700',
          variant === 'wide' ? 'text-2xl md:text-3xl' : 'text-lg md:text-xl',
        ]}
      >
        {entry.title}
      </h3>

      {
        entry.summary && variant !== 'compact' && (
          <p class="mt-2 line-clamp-2 text-[0.92rem] leading-relaxed text-ink-500">
            {entry.summary}
          </p>
        )
      }
    </div>
  </a>
</article>
