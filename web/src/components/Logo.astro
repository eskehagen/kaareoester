---
interface Props {
  class?: string;
  /** Sæt til false, hvis logoet står sammen med en synlig navnetekst. */
  labelled?: boolean;
}

const { class: className = '', labelled = true } = Astro.props;

/**
 * Mærket fra det oprindelige site: en klode i navy/petroleum med
 * Ø-skråstregen som lyskegle og en grøn prik hvor stregen rammer.
 * Geometrien er uændret fra assets/images/logo.svg.
 *
 * Gradienten får et unikt id pr. forekomst, så flere logoer på samme
 * side ikke overtager hinandens fyld.
 */
const uid = `logo-${Math.random().toString(36).slice(2, 8)}`;
---

<svg
  viewBox="0 0 240 240"
  class={className}
  role={labelled ? 'img' : 'presentation'}
  aria-label={labelled ? 'Kaare Øster' : undefined}
  aria-hidden={labelled ? undefined : 'true'}
  xmlns="http://www.w3.org/2000/svg"
>
  <defs>
    <linearGradient id={uid} x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#1a3a5c"></stop>
      <stop offset="100%" stop-color="#2d7a6e"></stop>
    </linearGradient>
  </defs>

  <circle cx="120" cy="120" r="110" fill={`url(#${uid})`}></circle>
  <circle cx="120" cy="120" r="72" fill={`url(#${uid})`}></circle>
  <circle cx="120" cy="120" r="48" fill="white"></circle>
  <line
    x1="66"
    y1="160"
    x2="174"
    y2="80"
    stroke="white"
    stroke-width="12"
    stroke-linecap="round"></line>
  <circle cx="173" cy="80" r="9" fill="#2d7a6e"></circle>
</svg>
