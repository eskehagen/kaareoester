---
import SmartImage from '~/components/SmartImage.astro';
import type { CmsImage } from '~/lib/cms/types';

interface Props {
  eyebrow: string;
  heading: string;
  intro: string;
  image?: CmsImage;
  /** Små nøgletal der vises under introteksten. */
  stats?: { value: string; label: string }[];
}

const { eyebrow, heading, intro, image, stats = [] } = Astro.props;

/** Overskriften brydes i ord, så de kan tone ind forskudt. */
const words = heading.split(' ');
---

<section class="relative overflow-hidden pt-[var(--header-height)]">
  <!-- Organiske farveflader i baggrunden -->
  <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
    <div
      class="absolute -left-40 top-10 h-[34rem] w-[34rem] rounded-[var(--radius-blob)] bg-clay-400/12 blur-3xl animate-[drift_24s_ease-in-out_infinite_alternate]"
    >
    </div>
    <div
      class="absolute -right-32 top-1/3 h-[28rem] w-[28rem] rounded-[var(--radius-blob)] bg-moss-400/12 blur-3xl"
    >
    </div>
    <div class="absolute inset-x-0 top-0 h-64 bg-gradient-to-b from-sand-50 to-transparent"></div>
  </div>

  <div class="shell grid items-center gap-14 py-16 md:py-24 lg:grid-cols-[1.05fr_0.95fr] lg:gap-20 lg:py-28">
    <div class="relative z-10">
      <p class="eyebrow hero-in" style="--d:0ms">{eyebrow}</p>

      <h1 class="mt-5 text-hero">
        {
          words.map((word, index) => (
            <span class="inline-block overflow-hidden align-bottom">
              <span class="hero-word inline-block" style={`--d:${120 + index * 70}ms`}>
                {word}
                {index < words.length - 1 && <>&nbsp;</>}
              </span>
            </span>
          ))
        }
      </h1>

      <p
        class="hero-in mt-7 max-w-xl text-[1.06rem] leading-[1.75] text-ink-500 md:text-[1.12rem]"
        style={`--d:${220 + words.length * 70}ms`}
      >
        {intro}
      </p>

      <div
        class="hero-in mt-9 flex flex-wrap items-center gap-3"
        style={`--d:${300 + words.length * 70}ms`}
      >
        <a
          href="/galleri"
          class="group inline-flex items-center gap-2.5 rounded-full bg-ink-900 px-7 py-3.5 text-[0.94rem] text-paper transition-all duration-400 hover:bg-clay-600 hover:shadow-[0_16px_36px_-16px_var(--color-clay-600)]"
        >
          Udforsk billedarkivet
          <span class="transition-transform duration-400 group-hover:translate-x-1">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M5 12h13M13 6l6 6-6 6" />
            </svg>
          </span>
        </a>
        <a
          href="/biografi"
          class="rounded-full border border-sand-300 px-7 py-3.5 text-[0.94rem] text-ink-700 transition-all duration-400 hover:border-ink-900 hover:bg-sand-50"
        >
          Om Kaare
        </a>
      </div>

      {
        stats.length > 0 && (
          <dl
            class="hero-in mt-12 flex flex-wrap gap-x-10 gap-y-5 border-t border-sand-200 pt-8"
            style={`--d:${380 + words.length * 70}ms`}
          >
            {stats.map((stat) => (
              <div>
                <dt class="font-display text-3xl text-ink-900">{stat.value}</dt>
                <dd class="mt-1 text-[0.78rem] uppercase tracking-[0.13em] text-ink-400">
                  {stat.label}
                </dd>
              </div>
            ))}
          </dl>
        )
      }
    </div>

    {
      image && (
        <div class="relative">
          <div class="hero-image relative overflow-hidden rounded-[2.5rem] shadow-frame md:rounded-[3.5rem]">
            <div class="aspect-[4/5] w-full md:aspect-[4/4.6]">
              <SmartImage
                image={image}
                widths={[600, 900, 1200, 1600]}
                sizes="(max-width: 1024px) 92vw, 46vw"
                loading="eager"
                fetchpriority="high"
                class="h-full w-full animate-[drift_26s_ease-in-out_infinite_alternate] object-cover"
              />
            </div>
            <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-ink-900/25 via-transparent to-transparent" />
          </div>

          {/* Lille organisk detalje der overlapper billedet */}
          <div
            class="pointer-events-none absolute -bottom-6 -left-6 hidden h-28 w-28 rounded-[var(--radius-blob)] border border-sand-300 bg-paper/80 backdrop-blur-sm md:block animate-float"
            aria-hidden="true"
          />
        </div>
      )
    }
  </div>

  <!-- Rullehint -->
  <div class="shell pb-14">
    <div class="flex items-center gap-3 text-[0.75rem] uppercase tracking-[0.16em] text-ink-400">
      <span class="scroll-line block h-px w-12 bg-sand-300"></span>
      Rul for at se mere
    </div>
  </div>
</section>

<style>
  /*
     --intro-offset sættes af forsidens introanimation, så heroens
     indtoning først går i gang, når forhænget er trukket fra.
  */
  .hero-in,
  .hero-word {
    opacity: 0;
    transform: translateY(var(--y, 18px));
    animation: hero-rise 1s cubic-bezier(0.22, 1, 0.36, 1) forwards;
    animation-delay: calc(var(--d, 0ms) + var(--intro-offset, 0s));
  }

  .hero-word {
    --y: 100%;
  }

  .hero-image {
    opacity: 0;
    transform: scale(0.96);
    animation: hero-frame 1.4s cubic-bezier(0.22, 1, 0.36, 1) forwards;
    animation-delay: calc(250ms + var(--intro-offset, 0s));
  }

  @keyframes hero-rise {
    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes hero-frame {
    to {
      opacity: 1;
      transform: none;
    }
  }

  .scroll-line {
    transform-origin: left;
    animation: scroll-hint 2.6s ease-in-out infinite;
  }

  @keyframes scroll-hint {
    0%,
    100% {
      transform: scaleX(0.4);
      opacity: 0.5;
    }
    50% {
      transform: scaleX(1);
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-in,
    .hero-word,
    .hero-image {
      opacity: 1;
      transform: none;
      animation: none;
    }
  }
</style>
