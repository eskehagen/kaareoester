---
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  href?: string;
  linkLabel?: string;
  align?: 'left' | 'center';
  class?: string;
}

const {
  eyebrow,
  title,
  description,
  href,
  linkLabel = 'Se alle',
  align = 'left',
  class: className = '',
} = Astro.props;
---

<div
  class:list={[
    'flex flex-col gap-6 md:flex-row md:items-end md:justify-between',
    align === 'center' && 'md:flex-col md:items-center md:text-center',
    className,
  ]}
  data-reveal
>
  <div class={align === 'center' ? 'max-w-2xl' : 'max-w-xl'}>
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h2 class="mt-3 text-display">{title}</h2>
    {description && <p class="mt-4 text-[1.02rem] leading-relaxed text-ink-500">{description}</p>}
  </div>

  {
    href && (
      <a
        href={href}
        class="group inline-flex shrink-0 items-center gap-2 text-[0.92rem] text-ink-700 transition-colors hover:text-clay-600"
      >
        <span class="link-underline">{linkLabel}</span>
        <span class="grid h-8 w-8 place-items-center rounded-full border border-sand-300 transition-all duration-400 group-hover:translate-x-1 group-hover:border-clay-500 group-hover:bg-clay-500 group-hover:text-white">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 12h13M13 6l6 6-6 6" />
          </svg>
        </span>
      </a>
    )
  }
</div>
